; Kerf settings. Edit, then right-click a module > Refresh all Kerf modules.
[Variables]

; Fonts
FontFace=Hanken Grotesk
MonoFace=JetBrains Mono
TimeSize=100
TimeWeight=300
DayFace=#FontFace#
DayItalic=0
DayScale=0.19
DayWeight=400
TimeTracking=-2
MicroTracking=2

; Scale: 1.00 at 1080p, 1.33 at 1440p, 2.00 at 4K
Scale=1.00

; Alignment margin (px)
EdgeMargin=48

; Clock
TimeFormat=%H:%M
TagFormat=24H

; Music line
WaveHeight=30
WaveAmp=0.9
WaveStroke=1.5
WaveFrequency=6
WaveSpeed=0.14
WaveGain=3
WaveEcho1=90
WaveEcho2=40

; Accent
Accent=242,184,75
AccentOnLight=150,114,46

; Ink: 0 auto, 1 light, 2 dark
InkMode=0
InkThreshold=0.30
InkDivider=1
WEConfig=
InkLight=244,246,248
InkDark=17,22,27
HaloLight=0,0,0
HaloDark=255,255,255

; Opacity (0-255)
A1=255
A2=189
A3=128
A4=77

; Temperature range (C)
TempMin=30
TempMax=100


; Set automatically
InkSource=none
Ink=244,246,248
Halo=0,0,0
AccInk=242,184,75
AF=0
