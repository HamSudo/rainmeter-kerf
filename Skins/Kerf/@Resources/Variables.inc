; Kerf settings. Edit, then right-click a module > Refresh all Kerf modules.
[Variables]

; Fonts
FontFace=Hanken Grotesk
MonoFace=JetBrains Mono
TimeSize=100
TimeWeight=300
DayWeight=400
TimeTracking=-2
MicroTracking=2

; Scale: 1.00 at 1080p, 1.33 at 1440p, 2.00 at 4K
Scale=1.00

; Clock
TimeFormat=%H:%M
TagFormat=24H

; Music line
WaveWidth=330
WaveHeight=40
WaveAmp=0.45
WaveStroke=1.5
WaveSensitivity=40
WaveMarker=1

; Date row width, set by the clock (0 = natural)
DateRowW=0

; Accent
Accent=242,184,75
AccentOnLight=150,114,46

; Ink: 0 auto, 1 light, 2 dark
InkMode=0
InkThreshold=0.30
InkDivider=1
WEConfig=
InkLight=244,246,248
InkDark=17,22,27
HaloLight=0,0,0
HaloDark=255,255,255

; Opacity (0-255)
A1=255
A2=189
A3=128
A4=77

; HWiNFO Gadget slots (-1 = find the sensor automatically)
CPUIndex=0
GPUIndex=1

; Temperature range (C)
TempMin=30
TempMax=100


; Set automatically
InkSource=none
Ink=244,246,248
Halo=0,0,0
AccInk=242,184,75
AF=0
